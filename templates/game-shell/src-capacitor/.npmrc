# Same reasoning as templates/game-shell/.npmrc — this node_modules ships
# as part of stories-engine itself (extraResource) and gets relocated by
# ordinary means (real installer, zip extract, drag-and-drop move). pnpm's
# default isolated/symlink-heavy .pnpm store does NOT survive that:
# confirmed by a real bug — a `pnpm add` run without repeating
# --config.node-linker=hoisted silently fell back to isolated mode for
# @capacitor/android/app/cli/core, and once the packaged app got moved to
# its real install location, Windows either broke the resulting symlinks
# or refused some deeply-nested .pnpm-store paths outright (MAX_PATH),
# producing "Accès refusé (os error 5)" trying to import '@capacitor/core'.
#
# NOTE: per templates/game-shell/.npmrc's own note, this file alone was
# NOT reliably honored in testing there either — package.json's
# vendor:game-shell script (and the src-capacitor setup notes) pass
# --config.node-linker=hoisted explicitly on every relevant pnpm command
# too; treat THAT as the real mechanism this depends on, this file as
# belt-and-suspenders documentation.
node-linker=hoisted
